# ── Google Gemini ─────────────────────────────────────────────
# Chave de API do Google AI Studio (Gemini)
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Supabase ──────────────────────────────────────────────────
# URL e chave anônima do projeto Supabase
# Obter em: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── URL pública do site (usada para Open Graph / SEO) ─────────
# Ex: https://plantaoseguro.com.br
NEXT_PUBLIC_SITE_URL=

# ── Página de vendas — Preços ──────────────────────────────────
# Altere aqui para atualizar os preços exibidos na landing page
NEXT_PUBLIC_PRICE_MONTHLY=
NEXT_PUBLIC_PRICE_ANNUAL=
NEXT_PUBLIC_PRICE_ANNUAL_MONTHLY=

# ── Página de vendas — Links de checkout (Kiwify) ─────────────
# Cole aqui os links gerados no painel da Kiwify para cada plano
NEXT_PUBLIC_KIWIFY_URL_MONTHLY=
NEXT_PUBLIC_KIWIFY_URL_ANNUAL=
